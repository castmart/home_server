# Copy to .env and fill in. .env is gitignored and must never be committed.

# ── Remote access mode ───────────────────────────────
# Leave empty for V2 (Tailscale installed on the host — the default).
# Set to "cloudflare" for V1 (cloudflared container + Cloudflare Tunnel).
# See REMOTE_ACCESS_SETUP.md for both.
COMPOSE_PROFILES=

# ── Immich ───────────────────────────────────────────
UPLOAD_LOCATION=./immich/library
DB_USERNAME=immich
DB_DATABASE_NAME=immich
DB_PASSWORD=change-me
IMMICH_VERSION=v2.7.5

# ── Pi-hole ──────────────────────────────────────────
PIHOLE_PASSWORD=change-me
TZ=Europe/Berlin

# ── Syncthing ────────────────────────────────────────
# Required. The GUI is published on the LAN and Syncthing ships with no
# authentication, so these are enforced at startup: compose refuses to run
# until both are set. Changing them here and running `docker compose up -d`
# re-applies them — the GUI is not the source of truth for the password.
SYNCTHING_GUI_USER=admin
SYNCTHING_GUI_PASSWORD=change-me

# Host path to the Obsidian vault that gets synced
OBSIDIAN_PATH=/mnt/data/syncthing/obsidian

# Device name shown to other Syncthing peers
SYNCTHING_HOSTNAME=servidor

# Pin the image, or leave unset for :latest. Read the running version with
# `docker compose exec syncthing syncthing --version`.
# SYNCTHING_VERSION=2.1.7

# ── Cloudflare Tunnel (V1 only) ──────────────────────
# Required only when COMPOSE_PROFILES=cloudflare. Leave unset for V2.
# TUNNEL_TOKEN=
