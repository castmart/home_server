# Copy to .env and fill in. .env is gitignored and must never be committed.

# ── Remote access mode ───────────────────────────────
# Leave empty for V2 (Tailscale installed on the host — the default).
# Set to "cloudflare" for V1 (cloudflared container + Cloudflare Tunnel).
# See REMOTE_ACCESS_SETUP.md for both.
COMPOSE_PROFILES=

# ── Immich ───────────────────────────────────────────
UPLOAD_LOCATION=./immich/library
# Postgres data directory. Network shares are not supported for the database.
DB_DATA_LOCATION=./immich/pgdata
DB_USERNAME=immich
DB_DATABASE_NAME=immich
DB_PASSWORD=change-me
# Pin one exact release and bump it deliberately — the `v3` metatag would move
# with every patch release. Upgrade procedure: IMMICH_UPGRADE.md.
IMMICH_VERSION=v3.3.5

# ── Pi-hole ──────────────────────────────────────────
PIHOLE_PASSWORD=change-me
TZ=Europe/Berlin

# ── Cloudflare Tunnel (V1 only) ──────────────────────
# Required only when COMPOSE_PROFILES=cloudflare. Leave unset for V2.
# TUNNEL_TOKEN=
